---
import type { Course } from '../lib/courses/catalog';
import { formatPrice } from '../lib/courses/catalog';
import type { Locale } from '../i18n/locales';
import { ui } from '../i18n/ui';
interface Props { course: Course; lang: Locale; completed?: number }
const { course, lang, completed } = Astro.props;
const t = ui(lang);
const total = course.lessons.length;
const minutes = course.lessons.reduce((sum, lesson) => sum + (lesson.minutes ?? 0), 0);
---
<a class="course-card" href={`/courses/${course.slug}/`} style={course.accent ? `--cover:${course.accent}33` : undefined}>
  <span class="icon" aria-hidden="true">{course.icon}</span>
  <h3>{course.title}</h3>
  <p>{course.summary}</p>
  {completed !== undefined && <div class="bar" role="progressbar" aria-valuemin="0" aria-valuemax={total} aria-valuenow={completed}><span style={`width:${total ? completed / total * 100 : 0}%`}></span></div>}
  <span class="meta">
    <span class:list={['badge', !course.isFree && 'badge-paid']}>{course.isFree ? t.free : formatPrice(course.price)}</span>
    <span>{completed !== undefined ? `${completed}/${total}` : total} {t.lessons}</span>
    {minutes > 0 && <span>· ~{minutes} {t.minutes}</span>}
  </span>
</a>
