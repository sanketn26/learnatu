---
import BaseLayout from '../layouts/BaseLayout.astro';
import { localeCopy, localePath, type Locale } from '../i18n/locales';
interface Props { lang: Locale }
const { lang } = Astro.props;
const copy = localeCopy[lang];
const paths = [
  ['✨', copy.learn, copy.learnDesc, localePath(lang, '/learn/')],
  ['🛡️', copy.safety, copy.safetyDesc, localePath(lang, '/safety/')],
  ['◎', copy.guides, copy.guidesDesc, localePath(lang, '/guides/')],
  ['🆘', copy.help, copy.helpDesc, localePath(lang, '/help/')]
];
---
<BaseLayout title="Learnatu" lang={lang}>
  <div class="shell">
    <section class="hero hero-with-image">
      <div><p class="eyebrow">{copy.eyebrow}</p><h1>{copy.title}</h1><p class="hero-copy">{copy.intro}</p></div>
      <img class="hero-image" src="/images/illustrations/hero.webp" alt="" width="1600" height="800" fetchpriority="high" />
    </section>
    <h2 class="section-title">{copy.choose}</h2>
    <div class="choice-grid home-grid">{paths.map(([icon, title, description, href]) => <a class="choice-card" href={href}><span class="choice-icon" aria-hidden="true">{icon}</span><span><span class="choice-title">{title}</span><span class="choice-description">{description}</span></span><span class="choice-arrow" aria-hidden="true">→</span></a>)}</div>
  </div>
</BaseLayout>
