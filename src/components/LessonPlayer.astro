---
import BaseLayout from '../layouts/BaseLayout.astro';
import type { Locale } from '../i18n/locales';
import { ui } from '../i18n/ui';
import type { loadLesson } from '../lib/courses/pages';
import { loginUrl } from '../lib/auth/session';
import Breadcrumbs from './Breadcrumbs.astro';
import { percentDone } from '../lib/courses/summary';
type Loaded = Exclude<Awaited<ReturnType<typeof loadLesson>>, { notFound: true } | { redirect: string }>;
interface Props { lang: Locale; data: Loaded }
const { lang, data } = Astro.props;
const { user, course, index, previewing, access, lesson: loaded, done } = data;
const lesson = course.lessons[index];
const t = ui(lang);
const prev = course.lessons[index - 1];
const next = course.lessons[index + 1];
const percent = percentDone(done.size, course.lessons.length);
const href = (slug: string) => `/courses/${course.slug}/${slug}/`;
---
<BaseLayout title={lesson.title} lang={lang}>
  <div class="player" data-course={course.slug} data-lesson={lesson.slug} style={`--c:${course.accent ?? `var(--cat-${course.category})`}`}>
    <details class="player-nav" open>
      <summary>{course.icon} {course.title} · {done.size}/{course.lessons.length}</summary>
      {course.modules.map((module) => <>
        {course.modules.length > 1 && <h4>{module.title}</h4>}
        <ol>{module.lessons.map((item) => <li class:list={[done.has(item.slug) && 'done-item']}>
          <a class:list={[done.has(item.slug) && 'done']} href={href(item.slug)} aria-current={item.slug === lesson.slug ? 'page' : undefined}>{item.title}</a>
        </li>)}</ol>
      </>)}
    </details>

    <div class="player-main">
      <Breadcrumbs items={[{ label: t.courses, href: '/courses/' }, { label: course.title, href: `/courses/${course.slug}/` }, { label: lesson.title }]} />
      <div class="lesson-bar" role="progressbar" aria-label={course.title} aria-valuemin="0" aria-valuemax="100" aria-valuenow={percent}><span style={`width:${percent}%`}></span></div>
      <article class="article">
        {loaded.fallback && <p class="translation-notice">{t.translationNotice}</p>}
        <p class="eyebrow">{index + 1} / {course.lessons.length}{lesson.minutes ? ` · ${lesson.minutes} ${t.minutes}` : ''}</p>
        <h1>{lesson.title}</h1>
        {loaded.data.objectives.length > 0 && <aside class="objectives"><strong>In this lesson</strong><ul>{loaded.data.objectives.map((o) => <li>{o}</li>)}</ul></aside>}
        {'Content' in loaded.body ? <loaded.body.Content /> : <Fragment set:html={loaded.body.html} />}
      </article>
      <div class="lesson-footer">
        {access.author && <p class="notice preview-banner">{previewing ? `Previewing version ${course.version} (not live yet)` : 'Preview mode'}{lesson.draft ? ' — draft lesson' : ''}{course.status === 'draft' ? ' — draft course' : ''}{previewing && <> · <a href={`/api/author/preview?exit=1&course=${course.slug}`}>Exit preview</a></>}</p>}
        {access.enrolled && <button class="btn complete-toggle" type="button" aria-pressed={done.has(lesson.slug)} data-label={t.markComplete} data-done={t.completed}>{done.has(lesson.slug) ? t.completed : t.markComplete}</button>}
        {!access.enrolled && course.isFree && (user
          ? <p class="notice">{t.enrolToSave} <button class="btn btn-secondary" type="button" data-enroll={course.slug} data-first={href(lesson.slug)}>{t.enrollFree}</button></p>
          : <p class="notice"><a href={loginUrl(href(lesson.slug))}>{t.saveProgress}</a></p>)}
        {!access.enrolled && !course.isFree && <p class="notice">{t.preview} · <a href={`/courses/${course.slug}/`}>{t.buy}</a></p>}
        <div class="pager">
          {prev ? <a class="btn btn-secondary" href={href(prev.slug)}>← {t.previous}</a> : <span></span>}
          {next ? <a class="btn" href={href(next.slug)}>{t.next} →</a> : <a class="btn" href={`/courses/${course.slug}/`}>🏅 {t.finish}</a>}
        </div>
      </div>
    </div>
  </div>
  <script src="../scripts/code-blocks.ts"></script>
  <script src="../scripts/quiz.ts"></script>
  <script src="../scripts/lesson.ts"></script>
  <script src="../scripts/enroll.ts"></script>
</BaseLayout>
