---
/** One line drawing per subject, in the subject's colour (set `--c` on a parent, or it uses the brand colour). */
interface Props { slug: string; size?: string }
const { slug, size = '3rem' } = Astro.props;
---
<svg class="cat-icon" style={`width:${size};height:${size}`} viewBox="0 0 80 80" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {slug === 'physics' && <><ellipse cx="40" cy="40" rx="34" ry="13" /><ellipse cx="40" cy="40" rx="34" ry="13" transform="rotate(60 40 40)" /><ellipse cx="40" cy="40" rx="34" ry="13" transform="rotate(120 40 40)" /><circle cx="40" cy="40" r="5" fill="currentColor" /></>}
  {slug === 'security' && <><rect x="16" y="34" width="48" height="36" rx="9" /><path d="M26 34V26a14 14 0 0 1 28 0v8" /><circle cx="40" cy="50" r="4" fill="currentColor" /><path d="M40 54v8" /></>}
  {slug === 'careers' && <><path d="M28 24 10 40l18 16" /><path d="M52 24l18 16-18 16" /><path d="M46 18 34 62" /></>}
  {slug === 'money' && <><circle cx="30" cy="48" r="18" /><circle cx="50" cy="32" r="18" /><path d="M44 26h12M44 32h12M50 26c6 0 6 10 0 10h-3l8 8" /></>}
  {slug === 'ai' && <><path d="M40 8c3 18 14 29 32 32-18 3-29 14-32 32-3-18-14-29-32-32 18-3 29-14 32-32z" /><circle cx="62" cy="16" r="3" fill="currentColor" /><circle cx="16" cy="64" r="3" fill="currentColor" /></>}
  {slug === 'digital-life' && <><rect x="22" y="8" width="36" height="64" rx="9" /><path d="M34 16h12" /><path d="M30 38c6-6 14-6 20 0M34 46c4-4 8-4 12 0" /><circle cx="40" cy="55" r="2.5" fill="currentColor" /></>}
</svg>
