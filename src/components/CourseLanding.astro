---
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatPrice } from '../lib/courses/catalog';
import { loginUrl } from '../lib/auth/session';
import type { Locale } from '../i18n/locales';
import { ui } from '../i18n/ui';
import type { loadLanding } from '../lib/courses/pages';
type Loaded = Exclude<Awaited<ReturnType<typeof loadLanding>>, { notFound: true }>;
interface Props { lang: Locale; data: Loaded }
const { lang, data } = Astro.props;
const { course, user, author, enrolled, done, About } = data;
const t = ui(lang);
const lessonHref = (lessonSlug: string) => `/courses/${course.slug}/${lessonSlug}/`;
const resume = course.lessons.find((lesson) => !done.has(lesson.slug)) ?? course.lessons[0];
const here = `/courses/${course.slug}/`;
const justPaid = Astro.url.searchParams.has('paid');
---
<BaseLayout title={course.title} description={course.summary} lang={lang}>
  <div class="shell landing" style={course.accent ? `--brand:${course.accent};--brand-soft:${course.accent}1f` : undefined}>
    <a class="back-link" href="/courses/">← {t.courses}</a>
    <header class="course-header">
      <span class="course-symbol" aria-hidden="true">{course.icon}</span>
      <div>
        <p class="eyebrow">{course.level} · {course.lessons.length} {t.lessons}</p>
        <h1>{course.title}</h1>
        <p class="hero-copy">{course.summary}</p>
      </div>
    </header>

    {author && <p class="notice preview-banner">Preview mode — you see this course as an author{course.status === 'draft' ? ' (draft: not visible to learners)' : ''}.</p>}
    {justPaid && !enrolled && <p class="notice">Payment received — we're confirming it with the bank. Refresh in a moment.</p>}
    <div class="landing-actions">
      {!course.isFree && !enrolled && <span class="price">{formatPrice(course.price, 'inr')}{course.price?.usd ? <small> / ${course.price.usd}</small> : null}</span>}
      {!user && course.isFree && <a class="btn" href={lessonHref(course.lessons[0].slug)}>{t.start} →</a>}
      {!user && course.isFree && <a href={loginUrl(here)}>{t.saveProgress}</a>}
      {!user && !course.isFree && <a class="btn" href={loginUrl(here)}>{t.signIn} → {t.buy}</a>}
      {user && enrolled && <a class="btn" href={lessonHref(resume.slug)}>{done.size ? t.continue : t.start} →</a>}
      {user && !enrolled && course.isFree && <button class="btn" type="button" data-enroll={course.slug} data-first={lessonHref(course.lessons[0].slug)}>{t.enrollFree}</button>}
      {user && !enrolled && !course.isFree && <a class="btn" href={`/checkout/${course.slug}/`}>{t.buy}</a>}
    </div>

    {(course.tags.length > 0 || course.prerequisites.length > 0) && <p class="meta-line">{course.tags.map((tag) => <span class="badge">{tag}</span>)}{course.prerequisites.length > 0 && <span>Before you start: {course.prerequisites.join(', ')}</span>}</p>}
    {About && <section class="article about"><About /></section>}
    <h2 class="section-title">{t.syllabus}</h2>
    <ol class="syllabus">
      {course.modules.map((module) => <li>
        {course.modules.length > 1 && <h3>{module.title}</h3>}
        <ul style="list-style:none;padding:0">
          {module.lessons.map((lesson) => <li>
            {enrolled || lesson.preview || course.isFree
              ? <a class:list={[done.has(lesson.slug) && 'done']} href={lessonHref(lesson.slug)}><span>{lesson.title}</span><span>{lesson.preview && !enrolled && !course.isFree ? t.preview : lesson.minutes ? `${lesson.minutes} ${t.minutes}` : ''}</span></a>
              : <span class="locked"><span>🔒 {lesson.title}</span><span>{lesson.minutes ? `${lesson.minutes} ${t.minutes}` : ''}</span></span>}
          </li>)}
        </ul>
      </li>)}
    </ol>
    {course.outcome && <section class="course-outcome"><span aria-hidden="true">🏅</span><div><strong>What you will be able to say</strong><p>“{course.outcome}”</p></div></section>}
  </div>
  <script src="../scripts/enroll.ts"></script>
</BaseLayout>
