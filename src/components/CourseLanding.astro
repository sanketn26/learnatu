---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import CategoryIcon from './CategoryIcon.astro';
import CourseActions from './CourseActions.astro';
import { formatPrice } from '../lib/courses/catalog';
import { categoryText } from '../data/categories';
import { collectObjectives, lessonState, percentDone, pickResume, totalMinutes } from '../lib/courses/summary';
import type { Locale } from '../i18n/locales';
import { ui } from '../i18n/ui';
import type { loadLanding } from '../lib/courses/pages';
type Loaded = Exclude<Awaited<ReturnType<typeof loadLanding>>, { notFound: true }>;
interface Props { lang: Locale; data: Loaded }
const { lang, data } = Astro.props;
const { course, user, author, previewing, enrolled, done, about } = data;
const t = ui(lang);
const category = categoryText(course.category, lang);
const lessonHref = (lessonSlug: string) => `/courses/${course.slug}/${lessonSlug}/`;
const resume = pickResume(course.lessons, done);
const minutes = totalMinutes(course.lessons);
const goals = collectObjectives(course.lessons);
const percent = percentDone(done.size, course.lessons.length);
const justPaid = Astro.url.searchParams.has('paid');
const actions = { lang, course, user, enrolled, started: done.size > 0, resumeSlug: resume.slug };
---
<BaseLayout title={course.title} description={course.summary} lang={lang}>
  <div class="shell landing" style={`--c:${course.accent ?? `var(--cat-${course.category})`}`}>
    <Breadcrumbs items={[{ label: t.courses, href: '/courses/' }, { label: category.name, href: `/courses/?category=${course.category}` }, { label: course.title }]} />

    <header class="c-hero">
      <div class="c-hero-text">
        <p class="eyebrow">{category.name} · {course.level}</p>
        <h1>{course.title}</h1>
        <p class="hero-copy">{course.summary}</p>
        {course.outcome && <div class="outcome"><span class="eyebrow">{t.outcomeLabel}</span><p>“{course.outcome}”</p></div>}
        <p class="facts"><span>{course.lessons.length} {t.lessons}</span>{minutes > 0 && <span>~{minutes} {t.minutes}</span>}<span>{course.isFree ? t.free : formatPrice(course.price, 'inr')}</span></p>
        {author && <p class="notice preview-banner">{previewing ? `Previewing version ${course.version} (not live yet). ` : 'Preview mode: you see this course as an author. '}{previewing && <a href={`/api/author/preview?exit=1&course=${course.slug}`}>Exit preview</a>}</p>}
        {justPaid && !enrolled && <p class="notice">Payment received — we're confirming it with the bank. Refresh in a moment.</p>}
        <CourseActions {...actions} />
      </div>
      <div class="c-cover">
        <CategoryIcon slug={course.category} size="7rem" />
        {enrolled && done.size > 0 && <div class="ring"><div class="ring-bar" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow={percent}><span style={`width:${percent}%`}></span></div><strong>{done.size} / {course.lessons.length}</strong></div>}
      </div>
    </header>

    <div class="c-body">
      <div class="c-main">
        {goals.length > 0 && <section>
          <h2 class="section-title">{t.syllabus}</h2>
          <ul class="goals">{goals.map((goal) => <li>{goal}</li>)}</ul>
        </section>}

        <section>
          <h2 class="section-title">{t.lessonsHeading}</h2>
          {course.modules.map((module) => <div class="module">
            {course.modules.length > 1 && <h3>{module.title}</h3>}
            <ol class="lesson-list">
              {module.lessons.map((lesson) => {
                const canRead = enrolled || lesson.preview || course.isFree;
                const state = lessonState({ done: done.has(lesson.slug), canRead, isResume: lesson.slug === resume.slug && (enrolled || course.isFree) });
                const meta = lesson.preview && !enrolled && !course.isFree ? t.preview : lesson.minutes ? `${lesson.minutes} ${t.minutes}` : '';
                return <li>
                  {canRead
                    ? <a class={`lesson-row is-${state}`} href={lessonHref(lesson.slug)}><span class="state" aria-hidden="true"></span><span class="lesson-title">{lesson.title}</span><span class="lesson-meta">{state === 'next' && done.size > 0 ? t.continue : meta}</span></a>
                    : <span class="lesson-row is-locked"><span class="state" aria-hidden="true"></span><span class="lesson-title">{lesson.title}</span><span class="lesson-meta">{meta}</span></span>}
                </li>;
              })}
            </ol>
          </div>)}
        </section>

        {about && <section class="article about"><h2 class="section-title">{t.about}</h2>{'Content' in about ? <about.Content /> : <Fragment set:html={about.html} />}</section>}
      </div>

      <aside class="c-aside">
        <p class="price">{course.isFree ? t.free : formatPrice(course.price, 'inr')}{!course.isFree && course.price?.usd ? <small> / ${course.price.usd}</small> : null}</p>
        <CourseActions {...actions} />
        <ul class="includes">
          <li>{course.lessons.length} {t.lessons}{minutes > 0 ? `, ~${minutes} ${t.minutes}` : ''}</li>
          <li>{t.includeCheck}</li>
          <li>{t.includeProgress}</li>
          <li>{t.includePhone}</li>
        </ul>
        {course.prerequisites.length > 0 && <p class="before"><strong>{t.before}</strong> {course.prerequisites.join(', ')}</p>}
      </aside>
    </div>
  </div>
  <script src="../scripts/enroll.ts"></script>
</BaseLayout>
