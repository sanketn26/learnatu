---
import '../styles/themes.css';
import '../styles/global.css';
import '../styles/platform.css';
import { ui } from '../i18n/ui';
import { localeCopy, type Locale } from '../i18n/locales';
interface Props { title?: string; description?: string; lang?: Locale; }
const { title = 'Learnatu', description = 'Short lessons that explain WhatsApp, UPI, Google, and ChatGPT — for people who were never taught this.', lang = Astro.locals.lang ?? 'en' } = Astro.props;
const copy = localeCopy[lang];
const t = ui(lang);
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#087f6b" />
    <script is:inline>try{var m=document.cookie.match(/(?:^|; )theme=(original|white|dark)/);if(m)document.documentElement.dataset.theme=m[1]}catch(e){}</script>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title === 'Learnatu' ? title : `${title} · Learnatu`}</title>
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <header class="site-header"><div class="shell header-inner">
      <a class="brand" href="/">Learnatu</a>
      <nav class="top-nav" aria-label="Main">
        <a href="/courses/">{t.courses}</a>
        <a href="/guides/">{t.library}</a>
        <a href="/dashboard/">{t.myLearning}</a>
      </nav>
      <details class="theme-menu">
        <summary aria-label={t.theme}><span aria-hidden="true">◐</span></summary>
        <div class="theme-list" role="group" aria-label={t.theme}>
          {(['system', 'original', 'white', 'dark'] as const).map((choice) => <button type="button" data-theme-choice={choice}>{t[choice]}</button>)}
        </div>
      </details>
      <a class="auth-link" id="auth-link" href="/login/" data-signed-out={t.signIn} data-signed-in={t.myLearning}>{t.signIn}</a>
    </div></header>
    <main id="content"><slot /></main>
    <nav class="bottom-nav" aria-label="Primary navigation">
      <a href="/"><span>⌂</span>{copy.home}</a>
      <a href="/courses/"><span>✦</span>{t.courses}</a>
      <a href="/dashboard/"><span>◈</span>{t.myLearning}</a>
      <a href="/guides/"><span>●</span>{t.library}</a>
    </nav>
    <script src="../scripts/auth-link.ts"></script>
    <script src="../scripts/theme.ts"></script>
  </body>
</html>
