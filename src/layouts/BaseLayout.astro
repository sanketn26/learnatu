---
import '../styles/themes.css';
import '../styles/global.css';
import '../styles/platform.css';
import 'katex/dist/katex.min.css';
import { ui } from '../i18n/ui';
import { localeCopy, type Locale } from '../i18n/locales';
interface Props { title?: string; description?: string; lang?: Locale; }
const { title = 'Learnatu', description = 'Short courses and one-minute answers on anything worth knowing, at your own pace.', lang = Astro.locals.lang ?? 'en' } = Astro.props;
const copy = localeCopy[lang];
const t = ui(lang);
const path = Astro.url.pathname;
// Marks the nav link for the section you are in.
const here = (prefix: string) => (path === prefix || path.startsWith(`${prefix}`) ? 'page' : undefined);
const isHome = path === '/';
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#087f6b" />
    <script is:inline>try{const m=document.cookie.match(/(?:^|; )theme=(original|white|dark)/);if(m)document.documentElement.dataset.theme=m[1];const z=document.cookie.match(/(?:^|; )size=([23])/);if(z)document.documentElement.dataset.size=z[1]}catch{/* cookies blocked: keep the defaults */}</script>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title === 'Learnatu' ? title : `${title} · Learnatu`}</title>
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <header class="site-header"><div class="shell header-inner">
      <a class="brand" href="/">Learnatu</a>
      <nav class="top-nav" aria-label="Main">
        <a href="/courses/" aria-current={here('/courses')}>{t.courses}</a>
        <a href="/guides/" aria-current={here('/guides')}>{t.library}</a>
        <a href="/dashboard/" aria-current={here('/dashboard')}>{t.myLearning}</a>
      </nav>
      <a class="icon-button" href="/search/" aria-label={t.search}><span aria-hidden="true">⌕</span></a>
      <details class="theme-menu">
        <summary aria-label={t.display}><span aria-hidden="true">◐</span></summary>
        <div class="theme-list">
          <div role="group" aria-label={t.theme}>
            <p class="menu-label">{t.theme}</p>
            {(['system', 'original', 'white', 'dark'] as const).map((choice) => <button type="button" data-theme-choice={choice}>{t[choice]}</button>)}
          </div>
          <div role="group" aria-label={t.textSize} class="size-row">
            <p class="menu-label">{t.textSize}</p>
            <div>{(['1', '2', '3'] as const).map((size) => <button type="button" data-size-choice={size} style={`font-size:${[1, 1.15, 1.3][+size - 1]}rem`} aria-label={`${t.textSize} ${size}`}>A</button>)}</div>
          </div>
        </div>
      </details>
      <a class="auth-link" id="auth-link" href="/login/" data-signed-out={t.signIn} data-signed-in={t.myLearning}>{t.signIn}</a>
    </div></header>
    <main id="content"><slot /></main>
    <footer class="site-footer"><div class="shell">
      <a class="brand" href="/">Learnatu</a>
      <nav aria-label="Footer">
        <a href="/courses/">{t.courses}</a><a href="/guides/">{t.library}</a><a href="/search/">{t.search}</a>
        <a href="/about/">{t.aboutLink}</a><a href="/privacy/">{t.privacy}</a><a href="/disclaimer/">{t.disclaimer}</a>
      </nav>
    </div></footer>
    <nav class="bottom-nav" aria-label="Primary navigation">
      <a href="/" aria-current={isHome ? 'page' : undefined}><span>⌂</span>{copy.home}</a>
      <a href="/courses/" aria-current={here('/courses')}><span>✦</span>{t.courses}</a>
      <a href="/dashboard/" aria-current={here('/dashboard')}><span>◈</span>{t.myLearning}</a>
      <a href="/guides/" aria-current={here('/guides')}><span>●</span>{t.library}</a>
    </nav>
    <script src="../scripts/auth-link.ts"></script>
    <script src="../scripts/theme.ts"></script>
    <script src="../scripts/diagrams.ts"></script>
    <script src="../scripts/flows.ts"></script>
  </body>
</html>
