---
import CourseLanding from '../../../../components/CourseLanding.astro';
import { loadLanding } from '../../../../lib/courses/pages';
import { localeParam, notFound } from '../../../../lib/routing';
export const prerender = false;
const lang = localeParam(Astro.params.lang);
if (!lang) return notFound();
const result = await loadLanding(await Astro.locals.getUser(), lang, Astro.params.course!);
if ('notFound' in result) return notFound();
---
<CourseLanding lang={lang} data={result} />
