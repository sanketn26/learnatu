---
import PathwayPage from '../../../../components/PathwayPage.astro';
import { pathways } from '../../../../data/pathways';
import { localeCodes, type Locale } from '../../../../i18n/locales';
export function getStaticPaths() {
  return localeCodes.filter((lang) => lang !== 'en').flatMap((lang) => pathways.map((pathway) => ({ params: { lang, pathway: pathway.slug }, props: { lang, pathwaySlug: pathway.slug } })));
}
const { lang, pathwaySlug } = Astro.props as { lang: Locale; pathwaySlug: string };
---
<PathwayPage lang={lang} slug={pathwaySlug} />
