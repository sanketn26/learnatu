---
import BaseLayout from '../layouts/BaseLayout.astro';
import { googleConfigured } from '../lib/auth/google';
import { safeNext } from '../lib/auth/session';
export const prerender = false;
const next = safeNext(Astro.url.searchParams.get('next'));
if (await Astro.locals.getUser()) return Astro.redirect(next);
const failed = Astro.url.searchParams.has('error');
---
<BaseLayout title="Sign in">
  <div class="login-card">
    <h1>Welcome to Learnatu</h1>
    <p class="hero-copy" style="margin:0 auto 1.5rem">Sign in to start learning and keep your progress.</p>
    {failed && <p class="notice">Sign-in didn't work. Please try again.</p>}
    {googleConfigured()
      ? <a class="google-btn" href={`/api/auth/google?next=${encodeURIComponent(next)}`}>
          <svg width="20" height="20" viewBox="0 0 48 48" aria-hidden="true"><path fill="#EA4335" d="M24 9.5c3.5 0 6.6 1.2 9.1 3.6l6.8-6.8C35.8 2.4 30.3 0 24 0 14.6 0 6.5 5.4 2.6 13.2l7.9 6.1C12.4 13.6 17.7 9.5 24 9.5z"/><path fill="#4285F4" d="M46.1 24.5c0-1.6-.1-3.1-.4-4.5H24v9h12.4c-.5 2.9-2.2 5.3-4.6 6.9l7.1 5.5c4.3-4 6.7-9.8 6.7-16.9z"/><path fill="#FBBC05" d="M10.5 28.7a14.5 14.5 0 0 1 0-9.4l-7.9-6.1a24 24 0 0 0 0 21.6l7.9-6.1z"/><path fill="#34A853" d="M24 48c6.5 0 11.9-2.1 15.9-5.8l-7.1-5.5c-2 1.4-4.9 2.3-8.8 2.3-6.3 0-11.6-4.1-13.5-9.8l-7.9 6.1C6.5 42.6 14.6 48 24 48z"/></svg>
          Continue with Google
        </a>
      : <p class="notice">Google sign-in isn't configured yet. Set GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET (see README).</p>}
  </div>
</BaseLayout>
