---
import LessonPlayer from '../../../../components/LessonPlayer.astro';
import { loadLesson } from '../../../../lib/courses/pages';
import { localeParam, notFound } from '../../../../lib/routing';
export const prerender = false;
const lang = 'en' as const;
if (!lang) return notFound();
const { course, lesson } = Astro.params;
const result = await loadLesson(await Astro.locals.getUser(), lang, course!, lesson!, Astro.url.pathname);
if ('redirect' in result) return Astro.redirect(result.redirect);
if ('notFound' in result) return notFound();
---
<LessonPlayer lang={lang} data={result} />
