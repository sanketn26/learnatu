---
import LessonPlayer from '../../../../components/LessonPlayer.astro';
import { loadLesson } from '../../../../lib/courses/pages';
import { PREVIEW_COOKIE, previewVersionFor } from '../../../../lib/courses/preview';
import { notFound } from '../../../../lib/routing';
export const prerender = false;
const lang = Astro.locals.lang!;
const { course, lesson } = Astro.params;
const result = await loadLesson(await Astro.locals.getUser(), lang, course!, lesson!, Astro.url.pathname, previewVersionFor(Astro.cookies.get(PREVIEW_COOKIE)?.value, course!));
if ('redirect' in result) return Astro.redirect(result.redirect);
if ('notFound' in result) return notFound();
---
<LessonPlayer lang={lang} data={result} />
