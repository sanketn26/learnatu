---
import PathwayPage from '../../../components/PathwayPage.astro';
import { pathways } from '../../../data/pathways';
export function getStaticPaths() {
  return pathways.map((pathway) => ({ params: { pathway: pathway.slug }, props: { pathwaySlug: pathway.slug } }));
}
const { pathwaySlug } = Astro.props;
---
<PathwayPage lang="en" slug={pathwaySlug} />
