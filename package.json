{
  "name": "learnatu",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "start": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro check && ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "db:migrate": "wrangler d1 migrations apply learnatu --local",
    "db:migrate:remote": "wrangler d1 migrations apply learnatu --remote",
    "deploy": "npm run build && wrangler deploy",
    "test": "node --test \"tests/*.test.mjs\" \"packages/*/tests/*.test.mjs\"",
    "course:new": "node scripts/course.mjs new",
    "course:validate": "node scripts/course.mjs validate",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.6",
    "@astrojs/cloudflare": "^14.3.4",
    "@astrojs/markdown-remark": "^7.3.1",
    "@learnatu/flowmap": "*",
    "@shikijs/core": "^4.5.0",
    "@shikijs/engine-javascript": "^4.5.0",
    "@shikijs/langs": "^4.5.0",
    "@shikijs/themes": "^4.5.0",
    "astro": "^7.3.2",
    "fflate": "^0.8.3",
    "katex": "^0.19.0",
    "mermaid": "^12.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^4.5.0",
    "typescript": "^5.9.3",
    "unified": "^11.0.5",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261007.1",
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-plugin-astro": "^1.7.0",
    "globals": "^17.13.0",
    "typescript-eslint": "^8.71.1",
    "wrangler": "^4.148.0"
  },
  "workspaces": [
    "packages/*"
  ]
}
